{
  "id": "id.king.hireslossless.internetarchive",
  "name": "Hi-Res Lossless (Internet Archive)",
  "version": "1.0.0",
  "description": "Searches Internet Archive audio items and serves original FLAC files when available. Hi-Res metadata is read from the FLAC STREAMINFO header when possible.",
  "resources": [
    "search",
    "stream"
  ],
  "allowDownloads": 1,
  "checkValidLossless": 0,
  "settings": [
    {
      "key": "quality",
      "type": "select",
      "label": "Audio quality",
      "default": "hires",
      "options": [
        {
          "value": "hires",
          "label": "Hi-Res / best available FLAC"
        },
        {
          "value": "lossless",
          "label": "Lossless FLAC"
        }
      ]
    }
  ]
}